package views

import (
	"strconv"

	"github.com/AkifhanIlgaz/tini/internal/platform/session"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/button"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/card"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/field"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/form"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/textfield"
	"github.com/AkifhanIlgaz/tini/internal/shared/icons"
	"github.com/AkifhanIlgaz/tini/internal/shared/layout"
)

// GeneralForm is the Mekan bilgileri page's own view-model for venue.Venue's
// Name — kept separate for the same reason SettingsForm is (see its doc
// comment).
type GeneralForm struct {
	Name string
}

// SettingsForm is the Mekan bilgileri page's own view-model for
// venue.VenueSettings — kept separate so this views package doesn't have to
// import its parent package (venue_handler.go already imports views, and
// views importing venue back would be an import cycle).
type SettingsForm struct {
	RoundIntervalMin          int
	CandidateCount            int
	RecentlyPlayedCooldownMin int
	CandidateCooldownMin      int
}

// fieldErrs is UpdateVenueRequest's per-field validation messages, keyed by
// form field name — nil on every path but a failed save (see
// venue_handler.go's Save).
templ Info(u session.User, path string, csrfToken string, general GeneralForm, settings SettingsForm, fieldErrs map[string]error) {
	@layout.Dashboard(layout.DashboardProps{
		Title:       "Mekan bilgileri",
		CSRFToken:   csrfToken,
		Path:        path,
		User:        u,
		Crumbs:      []layout.Crumb{{Label: "Anasayfa", Href: "/dashboard"}, {Label: "Mekan bilgileri"}},
		AppName:     layout.AppName,
		FooterItems: layout.FooterItems,
	}) {
		<div class="grid gap-4 lg:grid-cols-2 lg:items-start">
			@qrCard()
			@settingsCard(general, settings, fieldErrs)
		</div>
	}
}

templ qrCard() {
	@card.Card(card.Props{}) {
		@card.Header() {
			@card.Title() {
				QR Kod
			}
			@card.Description() {
				Müşteriler bu kodu okutarak mekana bağlanır.
			}
		}
		@card.Content("items-center", "gap-4") {
			<div class="flex aspect-square w-full max-w-56 items-center justify-center rounded-2xl border border-dashed border-border p-8 text-muted">
				@icons.QrCode()
			</div>
			@button.Button(button.Props{Variant: button.VariantOutline}) {
				@icons.Download()
				İndir
			}
		}
	}
}

// settingsCardID is the target settingsCard's Kaydet button swaps into —
// the handler re-renders the full Info page on save (it needs venue.Venue's
// fresh values anyway), and hx-select/hx-target pick this card back out of
// that response so only it gets replaced.
const settingsCardID = "venue-settings-card"

// settingsCard's Kaydet button sets hx-push-url="false" to override the
// hx-push-url="true" it would otherwise inherit from the dashboard layout's
// boosted wrapper (see layout.Dashboard) — without it, htmx pushes
// /venue/save into the address bar even though the swap is scoped to this
// card, and a refresh then 404s (no GET /venue/save route).
templ settingsCard(general GeneralForm, settings SettingsForm, fieldErrs map[string]error) {
	@card.Card(card.Props{Attrs: templ.Attributes{"id": settingsCardID}}) {
		@card.Header() {
			@card.Title() {
				Mekan bilgileri
			}
			@card.Description() {
				Mekanının adı ve oylama turlarının nasıl işleyeceği buradan yönetilir.
			}
		}
		@card.Content() {
			@form.Form(form.Props{}, "flex flex-col gap-4") {
				@textfield.TextField(textfield.Props{Name: "name", Type: "text", Value: general.Name, IsRequired: true, IsInvalid: fieldErrs["name"] != nil}) {
					@field.Label(field.LabelProps{}) {
						Mekan adı
					}
					@textfield.Input(textfield.InputProps{Placeholder: "Mekanının adını gir"})
					if err := fieldErrs["name"]; err != nil {
						@field.FieldError() {
							{ err.Error() }
						}
					}
				}
				@settingsField("roundIntervalMin", "Tur aralığı (dk)", settings.RoundIntervalMin, "Her oylama turu bu kadar dakikada bir başlar.", fieldErrs)
				@settingsField("candidateCount", "Aday sayısı", settings.CandidateCount, "Her turda kaç şarkı aday olarak gösterilir.", fieldErrs)
				@settingsField("recentlyPlayedCooldownMin", "Son çalınanlar bekleme süresi (dk)", settings.RecentlyPlayedCooldownMin, "Bir şarkının tekrar aday/fallback olabilmesi için son çalınışından bu kadar dakika geçmesi gerekir.", fieldErrs)
				@settingsField("candidateCooldownMin", "Aday bekleme süresi (dk)", settings.CandidateCooldownMin, "Bir şarkının turda tekrar aday olabilmesi için son aday olduğu andan bu kadar dakika geçmesi gerekir.", fieldErrs)
				@button.Button(button.Props{Attrs: templ.Attributes{
					"hx-post":     "/venue/save",
					"hx-target":   "#" + settingsCardID,
					"hx-select":   "#" + settingsCardID,
					"hx-swap":     "outerHTML",
					"hx-push-url": "false",
				}}, "self-start") {
					Kaydet
				}
			}
		}
	}
}

// settingsField renders one number input pre-filled with value — htmx
// serializes it from the closest <form> when the Kaydet button (a plain
// hx-post, not a native submit — see button.Button's doc comment) fires.
templ settingsField(name string, label string, value int, description string, fieldErrs map[string]error) {
	@textfield.TextField(textfield.Props{Name: name, Type: "number", Value: strconv.Itoa(value), IsRequired: true, IsInvalid: fieldErrs[name] != nil}) {
		@field.Label(field.LabelProps{}) {
			{ label }
		}
		@textfield.Input(textfield.InputProps{Attrs: templ.Attributes{"min": "0"}})
		if err := fieldErrs[name]; err != nil {
			@field.FieldError() {
				{ err.Error() }
			}
		} else {
			@field.Description() {
				{ description }
			}
		}
	}
}
