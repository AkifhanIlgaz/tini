package views

import (
	"github.com/AkifhanIlgaz/tini/internal/platform/session"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/alertdialog"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/avatar"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/button"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/card"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/chip"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/field"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/form"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/table"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/textfield"
	"github.com/AkifhanIlgaz/tini/internal/shared/icons"
	"github.com/AkifhanIlgaz/tini/internal/shared/layout"
)

// UserRow is the Users page's own view-model — kept separate from
// user.User so this views package doesn't have to import its parent
// package (user_handler.go already imports views, and views importing
// user back would be an import cycle).
type UserRow struct {
	ID        string
	Name      string
	Email     string
	AvatarURL string
	RoleLabel string
	// IsAdmin gates the delete action — only admins can be removed, not
	// the venue's boss.
	IsAdmin bool
}

templ Users(u session.User, path string, csrfToken string, rows []UserRow) {
	@layout.Dashboard(layout.DashboardProps{
		Title:       "Kullanıcılar",
		CSRFToken:   csrfToken,
		Path:        path,
		User:        u,
		Crumbs:      []layout.Crumb{{Label: "Panel", Href: "/dashboard"}, {Label: "Kullanıcılar"}},
		AppName:     layout.AppName,
		FooterItems: layout.FooterItems,
	}) {
		<div class="mb-4">
			<h1 class="text-lg font-bold text-foreground">Kullanıcılar</h1>
			<p class="text-sm text-muted/70">Venue'ne bağlı kullanıcıları görüntüle, admin davet et veya kaldır.</p>
		</div>
		@card.Card(card.Props{}, "mb-4") {
			@card.Header() {
				@card.Description() {
					Davet ettiğin kişi Google ile giriş yaptığında bu venue'ye otomatik bağlanır.
				}
			}
			@card.Content() {
				@inviteAdminForm()
			}
		}
		@table.Table(table.Props{}) {
			@table.Header() {
				@table.Column() {
					Kullanıcı
				}
				@table.Column() {
					E-posta
				}
				@table.Column() {
					Rol
				}
				@table.Column()
			}
			@table.Body() {
				for _, row := range rows {
					@userRow(row)
				}
			}
		}
	}
}

// inviteAdminFormID is the target inviteAdminForm's Admin Ekle button swaps
// into on a validation/duplicate-email failure — see InviteAdminForm's doc
// comment.
const inviteAdminFormID = "invite-admin-form"

templ inviteAdminForm() {
	@InviteAdminForm("", nil)
}

// InviteAdminForm POSTs to /users on the button click (not a native
// submit — button.Button always renders type="button", see its doc
// comment). htmx still serializes the closest <form>'s fields for a
// non-form-element trigger, so the email input's value goes along. Success
// responds with HX-Redirect (back to this same page, see
// Handler.InviteAdmin) regardless of the swap below. A
// validation/duplicate-email failure re-renders this form via
// hx-select/hx-target scoped to inviteAdminFormID, so the email field
// shows its field.FieldError inline instead of a toast — fieldErrs is nil
// on every path but that one. hx-push-url="false" overrides the
// hx-push-url="true" this form would otherwise inherit from the dashboard
// layout's boosted wrapper (see views.settingsCard's identical comment in
// the venue feature). The row aligns items-start (not items-end) with the
// button offset sm:mt-6 (label's line-height + the textfield's gap-1) to
// line the button up with the input on its own — items-end would instead
// track the field's bottom edge, which moves down once field.FieldError
// adds height under the input.
templ InviteAdminForm(email string, fieldErrs map[string]error) {
	@form.Form(form.Props{Attrs: templ.Attributes{"id": inviteAdminFormID}}, "flex flex-col items-stretch gap-2 sm:flex-row sm:items-start") {
		@textfield.TextField(textfield.Props{Name: "email", Type: "email", Value: email, IsRequired: true, IsInvalid: fieldErrs["email"] != nil}, "w-full sm:min-w-64") {
			@field.Label(field.LabelProps{}) {
				E-posta
			}
			@textfield.Input(textfield.InputProps{Placeholder: "Eklemek istediğin e-postayı gir"})
			if err := fieldErrs["email"]; err != nil {
				@field.FieldError() {
					{ err.Error() }
				}
			}
		}
		@button.Button(button.Props{Attrs: templ.Attributes{
			"hx-post":     "/users",
			"hx-target":   "#" + inviteAdminFormID,
			"hx-select":   "#" + inviteAdminFormID,
			"hx-swap":     "outerHTML",
			"hx-push-url": "false",
		}}, "sm:mt-6") {
			Admin Ekle
		}
	}
}

templ userRow(row UserRow) {
	@table.Row() {
		@table.Cell("") {
			<div class="flex items-center gap-2">
				@avatar.Avatar(avatar.Props{Size: avatar.SizeSm}) {
					@avatar.Image(avatar.ImageProps{Src: row.AvatarURL, Alt: row.Name})
					@avatar.Fallback(avatar.FallbackProps{}) {
						{ initial(row.Name) }
					}
				}
				<span class="font-medium text-foreground">{ row.Name }</span>
			</div>
		}
		@table.Cell("") {
			{ row.Email }
		}
		@table.Cell("") {
			@chip.Chip(chip.Props{Variant: chip.VariantSoft, Color: roleColor(row.IsAdmin), Size: chip.SizeSm}) {
				@chip.Label() {
					{ row.RoleLabel }
				}
			}
		}
		@table.Cell() {
			<div class="flex justify-end">
				if row.IsAdmin {
					@deleteUserDialog(row)
				}
			</div>
		}
	}
}

// roleColor gives the boss and admins visually distinct chip colors —
// IsAdmin is all UserRow carries (see its doc comment for why it doesn't
// hold the raw user.Role), but that's enough since there are only two roles.
func roleColor(isAdmin bool) chip.Color {
	if isAdmin {
		return chip.ColorSuccess
	}

	return chip.ColorAccent
}

templ deleteUserDialog(row UserRow) {
	@alertdialog.AlertDialog() {
		@button.Button(button.Props{Variant: button.VariantDangerSoft, Size: button.SizeSm}) {
			@icons.Trash2()
			Sil
		}
		@alertdialog.AlertDialogBackdrop(alertdialog.BackdropProps{IsDismissable: true}) {
			@alertdialog.AlertDialogContainer(alertdialog.ContainerProps{}) {
				@alertdialog.AlertDialogDialog() {
					@alertdialog.AlertDialogIcon(alertdialog.IconProps{Status: alertdialog.StatusDanger})
					@alertdialog.AlertDialogHeader() {
						@alertdialog.AlertDialogHeading() {
							{ row.Name } kullanıcısını silmek istediğine emin misin?
						}
					}
					@alertdialog.AlertDialogBody() {
						<p>Bu işlem geri alınamaz.</p>
					}
					@alertdialog.AlertDialogFooter() {
						@button.Button(button.Props{Variant: button.VariantGhost, Attrs: templ.Attributes{"slot": "close"}}) {
							Vazgeç
						}
						@button.Button(button.Props{
							Variant: button.VariantDanger,
							Attrs:   templ.Attributes{"slot": "close", "hx-post": "/users/" + row.ID + "/delete"},
						}) {
							Sil
						}
					}
					@alertdialog.AlertDialogCloseTrigger()
				}
			}
		}
	}
}

// initial is the avatar fallback's letter — row.Name can be empty for an
// invited admin who hasn't logged in via Google yet.
func initial(name string) string {
	if name == "" {
		return "?"
	}

	return string([]rune(name)[0])
}
