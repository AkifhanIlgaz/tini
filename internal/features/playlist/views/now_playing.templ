package views

import "github.com/AkifhanIlgaz/tini/internal/shared/icons"

// now_playing.templ renders the persistent player pill's track content
// (internal/shared/layout.Dashboard.PlayerBar mounts an empty
// #now-playing-info shell that POSTs to /playlist/now-playing/next on load
// and swaps this in, static/js/player.js re-triggers the same request —
// with the just-finished track's youtube id — every time playback
// advances). Styled after jukebox's admin NowPlayingIndicator
// (~/Desktop/workspace/jukebox/frontend/features/admin/components/NowPlayingIndicator.tsx):
// a circular thumbnail, title/channel next to it. NowPlayingTrack is its
// own type here, not playlist.PlaylistItem,
// for the same reason PlaylistRow is (see playlist.templ's doc comment) —
// views can't import playlist.
type NowPlayingTrack struct {
	YoutubeID string
	Title     string
	Channel   string
	Thumbnail string
}

// nowPlayingID is the stable id both the layout's initial shell and every
// swapped response below share — hx-target/hx-swap="outerHTML" on the shell
// keep pointing at whichever one is currently in the DOM (same "stable id +
// outerHTML" pattern as AddLinkForm/addLinkFormID).
const nowPlayingID = "now-playing-info"

// NowPlaying renders #now-playing-info's content. track == nil means the
// playlist has no items at all (PlaylistHandler.NextTrack's ErrItemNotFound
// path) — rendered with no data-youtube-id attribute so static/js/player.js
// knows not to try loading anything.
templ NowPlaying(track *NowPlayingTrack) {
	if track == nil {
		<div id={ nowPlayingID } class="flex min-w-0 flex-1 items-center gap-2">
			<div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-surface-tertiary text-muted">
				@icons.ListMusic()
			</div>
			<span class="truncate text-xs text-muted">Çalan şarkı yok</span>
		</div>
	} else {
		<div id={ nowPlayingID } class="flex min-w-0 flex-1 items-center gap-2 sm:gap-3" data-youtube-id={ track.YoutubeID }>
			<div class="size-7 shrink-0 overflow-hidden rounded-full bg-surface-tertiary ring-2 ring-accent/40">
				<img class="h-full w-full object-cover" src={ track.Thumbnail } alt={ track.Title } onerror="this.style.visibility='hidden'"/>
			</div>
			<div class="min-w-0 flex-1 text-left leading-tight sm:flex-none sm:shrink-0 sm:basis-32">
				<div class="truncate text-xs font-semibold text-foreground">{ track.Title }</div>
				<div class="truncate text-[0.6875rem] font-medium text-accent">{ track.Channel }</div>
			</div>
		</div>
	}
}
