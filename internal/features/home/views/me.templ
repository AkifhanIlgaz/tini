package views

import (
	"strings"

	"github.com/AkifhanIlgaz/tini/internal/platform/session"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/button"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/card"
	"github.com/AkifhanIlgaz/tini/internal/shared/layout"
)

templ Me(user session.User, csrfToken string) {
	@layout.Base("Hesabım", csrfToken) {
		@card.Card(card.Props{}) {
			@card.Header() {
				@card.Title() {
					Merhaba, { user.Email }
				}
			}
			@card.Content() {
				<p>ID: { user.ID.Hex() }</p>
				<p>Roller: { strings.Join(user.Roles, ", ") }</p>
			}
			@card.Footer() {
				@button.Button(button.Props{
					Variant: button.VariantDanger,
					Attrs:   templ.Attributes{"hx-post": "/auth/logout"},
				}) {
					Çıkış yap
				}
			}
		}
	}
}
