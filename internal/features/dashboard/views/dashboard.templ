package views

import (
	"github.com/AkifhanIlgaz/tini/internal/platform/session"
	"github.com/AkifhanIlgaz/tini/internal/shared/components/card"
	"github.com/AkifhanIlgaz/tini/internal/shared/layout"
)

// Dashboard is the app's home page (Anasayfa) — general, at-a-glance
// features live here.
templ Dashboard(u session.User, path string, csrfToken string) {
	@layout.Dashboard(layout.DashboardProps{
		Title:     "Anasayfa",
		CSRFToken: csrfToken,
		Path:      path,
		User:      u,
		Crumbs:      dashboardCrumbs(),
		AppName:     layout.AppName,
		FooterItems: layout.FooterItems,
	}) {
		@card.Card(card.Props{}) {
			@card.Header() {
				@card.Title() {
					Hoş geldin, { u.Email }
				}
				@card.Description() {
					Genel özellikler burada yer alacak.
				}
			}
		}
	}
}
