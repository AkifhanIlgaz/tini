// Package sidebar renders the dashboard's left navigation: a flat column
// of links that stays fixed while the page content scrolls.
// Collapse/mobile-drawer state and the [.sidebar-*] CSS backing it live in
// static/js/sidebar.js and input.css — see internal/shared/layout.Dashboard,
// which is the only place this gets mounted.
package sidebar

import (
	"github.com/AkifhanIlgaz/tini/internal/shared/icons"
	"github.com/AkifhanIlgaz/tini/internal/shared/utils"
)

type Props struct {
	AppName    string
	AppHref    string
	// Logo is the mark shown to the left of AppName, and alone once the
	// sidebar is collapsed (AppName hides with the rest of .sidebar-label).
	// Defaults to icons.Layers — swap it for the app's real logo.
	Logo       IconFunc
	Items      []NavItem
	ActivePath string
}

// logoIcon returns p.Logo, or a generic placeholder mark if the caller
// didn't set one — this is a template repo, so most projects built from it
// will pass their own.
func logoIcon(p Props) IconFunc {
	if p.Logo != nil {
		return p.Logo
	}
	return icons.Layers
}

templ Sidebar(p Props) {
	<aside id="app-sidebar" class="sidebar" hx-swap-oob="true">
		<div class="sidebar-head">
			<a href={ templ.URL(utils.If(p.AppHref == "", "/", p.AppHref)) } class="sidebar-brand ">
				@NavIcon(logoIcon(p))
				<span class="sidebar-label truncate text-lg font-semibold text-foreground">{ p.AppName }</span>
			</a>
			<button type="button" class="button button--ghost button--sm button--icon-only lg:hidden" aria-label="Menüyü kapat" onclick="window.__toggleMobileSidebar()">
				@icons.X()
			</button>
		</div>
		<nav class="flex flex-1 flex-col gap-1 overflow-y-auto py-2" aria-label="Uygulama menüsü">
			for _, it := range p.Items {
				@Link(p.ActivePath, it)
			}
		</nav>
		<div class="sidebar-footer">
			{ children... }
		</div>
	</aside>
}

templ NavIcon(icon IconFunc) {
	if icon != nil {
		@icon()
	}
}

templ Link(activePath string, it NavItem) {
	{{ active := navActive(activePath, it.Href) }}
	<a
		href={ templ.URL(it.Href) }
		class={ utils.Cn("sidebar-link", utils.If(active, "sidebar-link-active", "")) }
		title={ it.Label }
		if active {
			aria-current="page"
		}
		{ it.Attrs... }
	>
		@NavIcon(it.Icon)
		<span class="sidebar-label">{ it.Label }</span>
	</a>
}
