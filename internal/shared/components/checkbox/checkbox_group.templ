package checkbox

import (
	"context"

	"github.com/AkifhanIlgaz/tini/internal/shared/utils"
)

// HeroUI v3 CheckboxGroup — içindeki Checkbox'lara variant/name/disabled/invalid
// değerlerini templ context ile miras bırakır.
//
//	@CheckboxGroup(CheckboxGroupProps{Name: "interests"}) {
//		@Label(LabelProps{}) { Select your interests }
//		@Description() { Choose all that apply }
//		@Checkbox(CheckboxProps{Value: "coding"}) { ... }
//		@FieldError() { ... }
//	}

type checkboxGroupCtxKey int

const checkboxGroupKey checkboxGroupCtxKey = 0

type GroupProps struct {
	Variant    Variant // default: primary
	Name       string
	IsDisabled bool
	IsInvalid  bool
	IsRequired bool
	Attrs      templ.Attributes
}

func checkboxGroup(ctx context.Context) GroupProps {
	if p, ok := ctx.Value(checkboxGroupKey).(GroupProps); ok {
		return p
	}
	return GroupProps{}
}

templ CheckboxGroup(p GroupProps, tw ...string) {
	{{
	variant := p.Variant
	if variant == "" {
		variant = VariantPrimary
	}
	ctx = context.WithValue(ctx, checkboxGroupKey, p)
	}}
	<div
		class={ utils.Cn("checkbox-group", "checkbox-group--"+variant.String(), tw) }
		data-slot="checkbox-group"
		role="group"
		data-disabled={ utils.BoolStr(p.IsDisabled) }
		data-invalid={ utils.BoolStr(p.IsInvalid) }
		data-required={ utils.BoolStr(p.IsRequired) }
		{ p.Attrs... }
	>
		{ children... }
	</div>
}
