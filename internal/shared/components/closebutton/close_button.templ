package closebutton

import "github.com/AkifhanIlgaz/tini/internal/shared/utils"

// HeroUI v3  — dialog/modal kapatma butonu; tek variant (default).
//
//	@(Props{})                     // varsayılan X ikonu
//	@Custom(Props{}) { özel ikon } // custom children
//
// aria-label ve data-slot varsayılanları yalnızca Attrs'ta yokken basılır;
// slot="close" gibi ek attribute'lar Attrs ile verilir.

type Props struct {
	IsDisabled bool
	Attrs      templ.Attributes
}

templ CloseButton(p Props, tw ...string) {
	@closeButtonRoot(p, tw...) {
		@closeIcon()
	}
}

templ Custom(p Props, tw ...string) {
	@closeButtonRoot(p, tw...) {
		{ children... }
	}
}

templ closeButtonRoot(p Props, tw ...string) {
	<button
		type="button"
		class={ utils.Cn("close-button", "close-button--default", tw) }
		if p.Attrs["data-slot"] == nil {
			data-slot="close-button"
		}
		if p.Attrs["aria-label"] == nil {
			aria-label="Close"
		}
		disabled?={ p.IsDisabled }
		{ p.Attrs... }
	>
		{ children... }
	</button>
}

// closeIcon, React'teki varsayılan CloseIcon'un birebir karşılığı (16x16 fill).
templ closeIcon() {
	<svg
		data-slot="close-button-icon"
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 16 16"
		width="16"
		height="16"
		fill="none"
		aria-hidden="true"
	>
		<path
			fill-rule="evenodd"
			clip-rule="evenodd"
			fill="currentColor"
			d="M3.47 3.47a.75.75 0 0 1 1.06 0L8 6.94l3.47-3.47a.75.75 0 1 1 1.06 1.06L9.06 8l3.47 3.47a.75.75 0 1 1-1.06 1.06L8 9.06l-3.47 3.47a.75.75 0 0 1-1.06-1.06L6.94 8 3.47 4.53a.75.75 0 0 1 0-1.06Z"
		></path>
	</svg>
}
