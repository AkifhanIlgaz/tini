// Package statusicon holds the default status glyph shared by HeroUI
// components that show a status (alertdialog, toast): success/warning/
// danger/default, matching React's InfoIcon/SuccessIcon/WarningIcon/
// DangerIcon.
package statusicon

templ StatusIcon(dataSlot string, status string) {
	<svg
		data-slot={ dataSlot }
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		switch status {
			case "success":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="m9 12 2 2 4-4"></path>
			case "warning":
				<path d="m21.73 18-8-14a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
				<path d="M12 9v4"></path>
				<path d="M12 17h.01"></path>
			case "danger":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 8v4"></path>
				<path d="M12 16h.01"></path>
			default:
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 16v-4"></path>
				<path d="M12 8h.01"></path>
		}
	</svg>
}
