package icons

// PanelLeft reproduces lucide's panel-left icon exactly (icons.lucide.dev,
// ISC-licensed) so any future icon added here follows the same source.
templ PanelLeft() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<rect width="18" height="18" x="3" y="3" rx="2"></rect>
		<path d="M9 3v18"></path>
	</svg>
}
